{
  "expo": {
    "name": "Pulse",
    "slug": "pulse",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "pulse",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1c2434"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
